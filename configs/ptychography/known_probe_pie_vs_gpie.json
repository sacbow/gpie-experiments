{
  "experiment": {
    "problem": "ptychography",
    "name": "known_probe_pie_vs_gpie",
    "method": "benchmark",
    "entrypoint": "runners.ptychography.benchmark_known_probe:run"
  },
  "data": {
    "object_size": 512,
    "eval_crop_size": 256,
    "n_trials": 5,
    "data_seed_base": 1000,
    "init_seed_base": 2000,
    "object": {
      "amplitude_image": "camera",
      "phase_image": "eagle",
      "normalize": "max",
      "phase_scale": 1.5707963267948966,
      "amplitude_min": 0.0
    }
  },
  "forward_model": {
    "probe": {
      "size": 64,
      "radius": 32.0,
      "soft_edge_width": 0.0,
      "phase_curvature": 0.0
    },
    "scan": {
      "type": "fermat",
      "target_sampling_ratios": [
        4.0, 3.0, 2.5, 2.4, 2.3, 2.2, 2.1, 2.0
      ],
      "jitter": 0,
      "margin": 0,
      "coverage_min_count": 1,
      "step_search": {
        "min": 16.0,
        "max": 64.0,
        "resolution": 0.01
      }
    },
    "noise_model": "gaussian",
    "snr_db": 30.0
  },
  "algorithm": {
    "methods": [
      "pie",
      "gpie"
    ],
    "pie": {
      "n_iter": 4000,
      "alpha": 0.1,
      "beta_object": 0.1,
      "shuffle": false
    },
    "gpie": {
      "n_iter": 1000,
      "damping": 0.1,
      "schedule": "sequential",
      "block_size": 1
    },
    "log_every": 20
  },
  "runtime": {
    "device": "cpu",
    "fft_engine": null,
    "verbose": false
  },
  "output": {
    "root": "results",
    "save_history": true,
    "save_figures": true,
    "save_reconstruction": true
  }
}