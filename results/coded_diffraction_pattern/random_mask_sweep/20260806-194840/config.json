    "noise_param": 1e-08
  },
  "output": {
    "root": "results",
    "save_figures": true,
    "save_history": true,
    "save_reconstruction": true
  },
  "runtime": {
    "device": "cpu",
    "fft_engine": null,
    "verbose": false
  }
